# Web UI port
WEB_PORT=7860

# Ollama port
OLLAMA_PORT=11434

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3

# Ollama model for transcript rewriting
LLM_MODEL=llama3:8b

# Piper voice model (name from https://rhasspy.github.io/piper-samples/)
PIPER_VOICE=en_US-lessac-high

# Blender render settings
RENDER_RESOLUTION_X=1920
RENDER_RESOLUTION_Y=1080
RENDER_FPS=30

# YouTube API (configure when ready)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
